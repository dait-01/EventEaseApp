@using EventEase.Models

<EditForm Model="Event" class="event-card border rounded p-3 shadow-sm">
    <DataAnnotationsValidator />

    <h3>@Event.Name</h3>

    <div class="mb-2">
        <label class="form-label fw-semibold" for="event-name">Name</label>
        <InputText id="event-name" class="form-control" Value="Event.Name" ValueChanged="@(async (string value) => await OnNameChanged(value))" ValueExpression="() => Event.Name" />
        <ValidationMessage For="@(() => Event.Name)" />
    </div>

    <div class="mb-2">
        <label class="form-label fw-semibold" for="event-date">Date</label>
        <InputDate id="event-date" class="form-control" Value="Event.Date" ValueChanged="@(async (DateTime? value) => await OnDateChanged(value))" ValueExpression="() => Event.Date" />
        <ValidationMessage For="@(() => Event.Date)" />
    </div>

    <div>
        <label class="form-label fw-semibold" for="event-location">Location</label>
        <InputText id="event-location" class="form-control" Value="Event.Location" ValueChanged="@(async (string value) => await OnLocationChanged(value))" ValueExpression="() => Event.Location" />
        <ValidationMessage For="@(() => Event.Location)" />
    </div>
</EditForm>

@code {
    [Parameter]
    public Event Event { get; set; } = new();

    [Parameter]
    public EventCallback<Event> EventChanged { get; set; }

    private async Task OnNameChanged(string value)
    {
        Event.Name = value ?? string.Empty;
        await NotifyChanged();
    }

    private async Task OnDateChanged(DateTime? value)
    {
        Event.Date = value;
        await NotifyChanged();
    }

    private async Task OnLocationChanged(string value)
    {
        Event.Location = value ?? string.Empty;
        await NotifyChanged();
    }

    private async Task NotifyChanged()
    {
        if (EventChanged.HasDelegate)
        {
            await EventChanged.InvokeAsync(Event);
        }
    }
}
