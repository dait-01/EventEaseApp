@page "/events/{id:int}"
@using EventEase.Components
@using EventEase.Models
@using EventEase.Services

<PageTitle>Event Details</PageTitle>

@if (eventItem is null)
{
    <EventNotFound />
}
else
{
    <h1>Event Details</h1>
    <div class="mt-3">
        <EventCard Event="eventItem" />
    </div>

    <NavLink class="btn btn-secondary mt-3" href="/events">Back to Events</NavLink>
    <NavLink class="btn btn-primary mt-3" href="@($"/register/{Id}")">Register</NavLink>
}

@code {
    [Inject]
    public EventService EventService { get; set; } = default!;

    [Parameter]
    public int Id { get; set; }

    private Event? eventItem;

    protected override void OnParametersSet()
    {
        eventItem = EventService.GetById(Id);
    }
}
