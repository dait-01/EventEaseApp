# ---------------------------------------------
# .gitignore for EventEase (Blazor WebAssembly, .NET 8)
# ---------------------------------------------

# Build output
[Bb]in/
[Oo]bj/
[Oo]ut/
publish/
artifacts/

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains Rider
.idea/
*.sln.iml

# Local secrets and publish profiles
secrets.json
*.pubxml
*.pubxml.user

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
project.lock.json
.nuget/

# Test and coverage output
[Tt]est[Rr]esult*/
*.trx
*.coverage
coverage*.json
coverage*.xml
TestResults/

# Logs and diagnostics
*.log
*.dmp
*.tmp
*.temp
*.cache
*.bak
*.orig

# Blazor / web assets generated at build time
wwwroot/_framework/
.sass-cache/
node_modules/

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Environment files
.env
.env.*